# ADHD Cognitive Co-Processor Environment Variables Configuration
# Copy this file to .env and configure as needed.

# 1. Copilot Security Token (Required for remote bind or modifying/executing endpoints)
ADHD_COPILOT_TOKEN=your_secure_random_token_here

# 2. Local Obsidian REST API Plugin Token (Optional, if auth is enabled in Obsidian REST API)
OBSIDIAN_API_TOKEN=your_obsidian_local_rest_api_token

# 3. CORS Allowed Origins (Comma-separated list of allowed origins)
# For remote access via Tailscale or specific devices, add their origins here.
JARVIS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 4. Host Bind Configuration
# Set to true to bind to 0.0.0.0 (enables remote connections if ADHD_COPILOT_TOKEN is set)
JARVIS_REMOTE=false

# 5. Model Overrides (Optional, overrides config.toml)
# JARVIS_MODEL=qwen3.5:9b
# JARVIS_REASONING_MODEL=qwen3.5:9b
# JARVIS_CODING_MODEL=qwen3.5:9b
