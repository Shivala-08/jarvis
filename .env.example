# ADHD Co-Processor — Environment Variables
# Copy to .env and fill in values, or export in your shell profile.

# ==============================================================================
# SECURITY (Required for remote access)
# ==============================================================================
# Generate once: openssl rand -hex 32
# The server REFUSES to bind to 0.0.0.0 unless this is set.
ADHD_COPILOT_TOKEN=

# ==============================================================================
# REMOTE ACCESS (Phase 11)
# ==============================================================================
# Set to "true" to bind to 0.0.0.0 instead of localhost.
# Only effective when ADHD_COPILOT_TOKEN is set.
JARVIS_REMOTE=true

# Comma-separated list of allowed CORS origins (PWA address).
# Example: http://YOUR-TAILSCALE-IP:8080
JARVIS_ALLOWED_ORIGINS=

# ==============================================================================
# MODEL CONFIGURATION (Optional overrides)
# ==============================================================================
# Override the default Ollama model (default: qwen3.5:9b)
# JARVIS_MODEL=qwen3.5:9b
# JARVIS_REASONING_MODEL=qwen3.5:9b
# JARVIS_CODING_MODEL=qwen3.5:9b

# ==============================================================================
# OBSIDIAN (Optional)
# ==============================================================================
# Set if you enabled auth in the Obsidian Local REST API plugin.
# Falls back to config/config.toml value if not set.
# OBSIDIAN_API_TOKEN=
